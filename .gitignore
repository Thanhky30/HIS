## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# ASP.NET Core
wwwroot/lib/
node_modules/

# Rider
.idea/

# VS Code
.vscode/

# Visual Studio cache files
.vs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Publish output
publish/
*.publishproj

# IIS Express
iisexpress/
*.vspscc
*.vssscc

# SQL Server files
*.mdf
*.ldf

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# NuGet
*.nupkg
packages/
.nuget/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper

# DotCover
*.dotCover

# Others
*.cache
*.bak
*.tmp
*.temp

# dotenv
.env
.env.*

# .agents
.agents/
.agent/
